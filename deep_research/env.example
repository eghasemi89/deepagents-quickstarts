# .env file used by load_dotenv to insert environment variables in the jupter environment
# copy example.env to .env
# Required for research agents with external search
TAVILY_API_KEY=your_tavily_api_key_here

# Required for model usage
ANTHROPIC_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here

# LangSmith Configuration (Required for Self-Hosted Lite License)
# NOTE: LANGSMITH_API_KEY is REQUIRED for self-hosted lite mode (free, up to 1M nodes)
# Even if you disable tracing, you still need the API key for license verification.
# To completely remove LangSmith, you need an enterprise license (LANGGRAPH_CLOUD_LICENSE_KEY).
# See LANGSMITH_LICENSE_GUIDE.md for details.

# Required for self-hosted lite license (free)
LANGSMITH_API_KEY=lsv2_pt_...

# Optional: Enable/disable tracing (license verification still requires API key)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=deep-agents-from-scratch

# Alternative: Enterprise License (removes LangSmith dependency)
# LANGGRAPH_CLOUD_LICENSE_KEY=your_enterprise_license_key

# Supabase Database Configuration (for persistent checkpoints and threads)
#
# IMPORTANT: Different LangGraph commands use different variables:
#
# 1. langgraph dev (local development):
#    - Uses in-memory storage by default
#    - POSTGRES_URI is ignored
#    - Data does NOT persist (this is by design for local testing)
#
# 2. langgraph up (deployment):
#    - Uses POSTGRES_URI_CUSTOM to connect to your Supabase database
#    - Set POSTGRES_URI_CUSTOM below for deployment
#    - Without it, langgraph up creates its own local Postgres container

# Required For langgraph up deployment (use your Supabase connection string):
POSTGRES_URI=postgresql://postgres.ltbwpsjgivrwxoevnolj:your_password@aws-1-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require

# Option 2: Use SUPABASE_DB_URI (for custom checkpointer setup, not used with langgraph dev)
# SUPABASE_DB_URI=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require

# Option 3: Use individual connection parameters (alternative to SUPABASE_DB_URI)
# SUPABASE_DB_HOST=db.your_project_ref.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your_password

# LangGraph Configuration (for Docker/self-hosted)
# REQUIRED: These use absolute paths in the container (/api/...)
# These MUST be set for authentication and custom HTTP app to work
# Use single quotes to wrap the JSON string, or no quotes if using export
LANGGRAPH_AUTH='{"path": "/api/security/auth.py:auth"}'
LANGGRAPH_HTTP='{"app": "/api/webapp_advanced.py:app"}'

# Required Supabase Authentication (if using auth.py)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key
